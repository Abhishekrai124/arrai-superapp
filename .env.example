# ARRAI SuperApp Supabase Configuration
# Create a free project at https://supabase.com and copy credentials from Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Razorpay Payment Gateway (Add in Vercel Environment Variables)
# Get from Razorpay Dashboard > Settings > API Keys
VITE_RAZORPAY_KEY_ID=rzp_live_your_key_id
